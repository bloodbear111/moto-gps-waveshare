# systemd 单元：/etc/systemd/system/moto-gps-gateway.service
#
# 网关自己只监听 127.0.0.1:8787（代码里写死），由同机 nginx 反代。
# 高德 Key 放在 /etc/moto-gps/gateway.env（0600，只有 root 可读），
# 不进仓库、不进 systemd 单元、不出现在 ps 输出里。

[Unit]
Description=MOTO GPS navigation gateway (AMap HTTP proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moto-gps
Group=moto-gps
WorkingDirectory=/opt/moto-gps/backend
EnvironmentFile=/etc/moto-gps/gateway.env
ExecStart=/usr/bin/node src/server.js

Restart=on-failure
RestartSec=3

# 这套限制按“只需要读自己的代码、只往外发 HTTPS”来收紧：
# 文件系统只读挂载、家目录不可见、/tmp 私有、只有 /var/lib/moto-gps 可写
# （地图瓦片缓存就落在那里）。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StateDirectory=moto-gps
MemoryMax=512M

[Install]
WantedBy=multi-user.target
